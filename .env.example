# Copy this file to .env (gitignored) and fill in your values for local dev.
#
# Two different tools read this file, and they read it differently:
#
#   wrangler dev   picks .env up automatically and exposes these as Worker
#                  bindings (Astro.locals.runtime.env). NOTE: if a .dev.vars
#                  file also exists it silently takes precedence — delete it.
#
#   supabase CLI   does NOT read .env. Export into your shell first:
#                    set -a; source .env; set +a
#
# In production these are set with `wrangler secret put <KEY>`, not from a file.

# --- App runtime (needed by wrangler dev / the deployed Worker) -------------

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ACCESS_TOKEN=your-access-token-here
SUPABASE_ANON_KEY=your-anon-key-here

# Bypasses every RLS policy. Server-side only — never pass this to a React
# island or any client-side prop.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Supabase CLI only (not used by the app at runtime) --------------------

# Personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# The database password you set when creating the project
SUPABASE_DB_PASSWORD=your-db-password
